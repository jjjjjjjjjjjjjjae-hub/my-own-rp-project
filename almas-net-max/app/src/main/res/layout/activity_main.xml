<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALMAS NET OPTIMIZER MAX v3"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2 режим: Hotspot Telecom + Phone Analyzer"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvHotspot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="📡 HOTSPOT TELECOM\nХотспотқа адам қосылса, әр клиентке берілетін Mbps лимитін таңдайсың."
            android:textColor="#E5E7EB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnHotspot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📡 HOTSPOT TELECOM — Mbps БЕРУ" />

        <Button
            android:id="@+id/btnHotspotOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="HOTSPOT ЛИМИТІН АЛУ" />

        <TextView
            android:id="@+id/tvAnalyzer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="📱 PHONE ANALYZER\nЖелі анализі іске қосылуда..."
            android:textColor="#E5E7EB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAnalyzer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📊 АНАЛИЗДІ ҚАЗІР ЖАҢАРТУ" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="⚠ ВИДЕО САПАСЫН ЕСКЕРТУ — ACCESSIBILITY" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accessibility тек сапа мәзіріндегі басылған 260p/360p/480p/720p/1080p сияқты мәтінді тану үшін керек. Жоғары сапа интернет мүмкіндігінен асса ескерту шығады."
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="Желі тексерілуде..."
            android:textColor="#E5E7EB"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="Network Score: --/100"
            android:textColor="#7CFFB2"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="Ping: -- ms\nJitter: -- ms\nLoss: --%\nDownload: -- Mbps"
            android:textColor="#E5E7EB"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ИНТЕРНЕТТІ ТОЛЫҚ ТЕКСЕРУ" />

        <Button
            android:id="@+id/btnSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="СИГНАЛДЫ ЖАҢАРТУ" />

        <TextView
            android:id="@+id/tvApn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#162033"
            android:padding="16dp"
            android:text="APN: Root арқылы тексеруге және оңтайландыруға болады."
            android:textColor="#E5E7EB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnApn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ROOT APN ТЕКСЕРУ" />

        <Button
            android:id="@+id/btnMaxApn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚡ MAX APN AUTO (ROOT)" />

        <Button
            android:id="@+id/btnRestoreApn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="APN BACKUP ҚАЙТАРУ" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hotspot Telecom: tc/HTB қолдауы бар root kernel-де клиенттің download және upload жылдамдығын шектейді. Phone Analyzer: шағын тесттер арқылы тұрақты жылдамдықты, jitter және loss-ты есептеп, видео сапасын болжайды."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
