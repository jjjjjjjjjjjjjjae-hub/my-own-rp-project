<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="true">

    <kz.almas.netoptimizer.NetworkSplashView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="54dp"
        android:letterSpacing="0.14"
        android:text="ALMAS NETWORK CORE"
        android:textColor="#55768D"
        android:textSize="10sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/ringOuter"
        android:layout_width="286dp"
        android:layout_height="286dp"
        android:layout_gravity="center"
        android:layout_marginBottom="58dp"
        android:background="@drawable/bg_splash_ring_outer" />

    <View
        android:id="@+id/ringInner"
        android:layout_width="214dp"
        android:layout_height="214dp"
        android:layout_gravity="center"
        android:layout_marginBottom="58dp"
        android:background="@drawable/bg_splash_ring_inner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingRight="26dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:contentDescription="ALMAS TELEKOM"
            android:elevation="12dp"
            android:src="@drawable/ic_almas_telekom" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:letterSpacing="0.14"
            android:text="ALMAS TELEKOM"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:letterSpacing="0.08"
            android:text="SMART NETWORK CONTROL"
            android:textColor="#8FEBD9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:letterSpacing="0.08"
            android:text="INITIALIZING NETWORK CORE"
            android:textColor="#78A5BC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-14dp"
            android:background="@drawable/bg_online_badge"
            android:letterSpacing="0.09"
            android:paddingLeft="15dp"
            android:paddingTop="7dp"
            android:paddingRight="15dp"
            android:paddingBottom="7dp"
            android:text="●  ALMAS TELEKOM • ONLINE"
            android:textColor="#B7FFE9"
            android:textSize="10sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="226dp"
            android:layout_height="4dp"
            android:layout_marginTop="21dp"
            android:background="@drawable/bg_splash_track">

            <View
                android:id="@+id/progressLine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_progress" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.08"
            android:text="SECURE LINK  •  v10"
            android:textColor="#456278"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:letterSpacing="0.08"
        android:text="NETWORK INTELLIGENCE SYSTEM"
        android:textColor="#3C596E"
        android:textSize="9sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/introLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF02060B">

        <View
            android:id="@+id/introBeam"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_splash_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingRight="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/introAlmas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="ALMAS"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/introTelekom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.16"
                    android:text="TELEKOM"
                    android:textColor="#36E4BE"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/introFeatures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="CONNECTING DIGITAL NETWORK"
                android:textColor="#7397A9"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
